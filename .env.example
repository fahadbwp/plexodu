# Plexudo - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit real secret values to version control.

# Core AI Credentials (Backend-only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API v3 Credentials (Backend-only)
YOUTUBE_API_KEY=

# Database Persistence
# Production: use a pooled PostgreSQL connection string (fake example below).
# DATABASE_URL=postgresql://example_user:example_password@db.example.invalid:6543/plexudo
# Empty uses SQLite only for local development.
DATABASE_URL=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://plexudo.vercel.app,http://localhost:3000,http://127.0.0.1:5000

# Server & Security Settings
SECRET_KEY=
PORT=5000
HOST=127.0.0.1
FLASK_ENV=production

# Rate limits per process (requests per minute)
API_RATE_LIMIT_PER_MIN=100
AI_RATE_LIMIT_PER_MIN=30

# Optional writable export/cache directory; Vercel defaults to /tmp
DATA_DIR=

# Needed from Phase 2; not consumed by Phase 0
CRON_SECRET=
